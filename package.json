{
  "name": "ferrycat",
  "version": "0.4.0",
  "mcpName": "io.github.GuoBug/ferrycat",
  "description": "FerryCat: Contract-driven cross-host AI agent handoff, code review & verification harness over MCP and SQLite WAL",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ferrycat": "bin/ferrycat.js",
    "ferrycat-cli": "bin/ferrycat-cli.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "README_zh.md",
    "LICENSE",
    "server.json",
    "glama.json"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "bump": "node scripts/bump-version.js",
    "start": "node --experimental-sqlite dist/index.js",
    "test": "node --experimental-sqlite --import tsx test/run-all.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuoBug/FerryCat.git"
  },
  "homepage": "https://github.com/GuoBug/FerryCat#readme",
  "bugs": {
    "url": "https://github.com/GuoBug/FerryCat/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "ai-agent",
    "multi-agent",
    "coding-agent",
    "agent-handoff",
    "agent-verification",
    "llm-evaluation",
    "code-review",
    "static-analysis",
    "deterministic-workflow",
    "claude-code",
    "cursor",
    "antigravity",
    "workbuddy",
    "sqlite-wal",
    "contract-driven",
    "sandbox"
  ],
  "author": "Guo Qiang (GuoBug) <https://github.com/GuoBug>",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2",
    "ajv": "^8.17.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
