{
  "name": "ferrycat",
  "version": "0.1.0",
  "description": "FerryCat: Contract-driven cross-host AI agent handoff & review bus over MCP and SQLite WAL",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ferrycat": "dist/index.js",
    "ferrycat-cli": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --experimental-sqlite dist/index.js",
    "test": "node --experimental-sqlite --import tsx test/run-all.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "multi-agent",
    "agent-handoff",
    "sqlite-wal",
    "antigravity",
    "workbuddy",
    "contract-driven"
  ],
  "author": "Guo Qiang (GuoBug) <https://github.com/GuoBug>",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2",
    "ajv": "^8.17.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
