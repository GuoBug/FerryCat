{
  "version": 1,
  "daemon": {
    "lock_id": "ferrycat-primary-daemon",
    "lease_ttl_sec": 30,
    "heartbeat_interval_ms": 5000,
    "poll_interval_ms": 1000,
    "notify": true,
    "webhook_url": "http://127.0.0.1:8787/ferrycat-events"
  },
  "agents": {
    "workbuddy": {
      "handlers": {
        "code_review": {
          "exec_file": "./scripts/static-analysis-gate.cjs",
          "pass_env": ["FERRYCAT_WORKSPACE_ROOT", "NODE_ENV"]
        }
      }
    },
    "codex-critic": {
      "handlers": {
        "architecture_audit": {
          "exec_file": "./scripts/codex-worker.cjs",
          "pass_env": ["CODEX_BIN", "USERPROFILE", "APPDATA", "LOCALAPPDATA"]
        }
      }
    }
  }
}
